<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:background="@mipmap/picture3"
    android:padding="32dp"
    tools:context=".LoginActivity">

    <TextView
        android:id="@+id/textView12"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/str_login_system"
        android:textAlignment="center"
        android:textColor="#00E5FF"
        android:textSize="38sp"
        android:textStyle="bold"
        android:shadowColor="#000000"
        android:shadowDx="4"
        android:shadowDy="4"
        android:shadowRadius="8"
        android:layout_marginBottom="40dp" />

    <TextView
        android:id="@+id/textView13"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#80000000"
        android:text="@string/str_username"
        android:textColor="#E0E0E0"
        android:textSize="18sp"
        android:textStyle="bold"
        android:padding="8dp" />

    <EditText
        android:id="@+id/editUsername"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/str_enter_your_user_name"
        android:textColor="#FFFFFF"
        android:textColorHint="#99FFFFFF"
        android:inputType="text"
        android:backgroundTint="#00E5FF"
        android:layout_marginBottom="16dp"
        android:minHeight="48dp" />

    <TextView
        android:id="@+id/textView14"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#80000000"
        android:text="@string/str_password"
        android:textColor="#E0E0E0"
        android:textSize="18sp"
        android:textStyle="bold"
        android:padding="8dp" />

    <EditText
        android:id="@+id/editPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/str_enter_your_password"
        android:textColor="#FFFFFF"
        android:textColorHint="#99FFFFFF"
        android:inputType="textPassword"
        android:backgroundTint="#00E5FF"
        android:layout_marginBottom="30dp"
        android:minHeight="48dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:onClick="LoginSystem"
            android:id="@+id/btnLogin"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:backgroundTint="#00B0FF"
            android:text="@string/str_login"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginEnd="8dp" />

        <Button
            android:onClick="ExitSystem"
            android:id="@+id/btnExit"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:backgroundTint="#455A64"
            android:text="@string/str_exit"
            android:textColor="#CFD8DC"
            android:textSize="16sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text=""
        android:textAlignment="center"
        android:textColor="#FF0000"
        android:textSize="16sp"
        android:textStyle="italic" />
</LinearLayout>